{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"env": {
		"BASH_DEFAULT_TIMEOUT_MS": "120000",
		"CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
		"CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
		"CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "64000",
		"CLAUDE_CODE_MAX_OUTPUT_TOKENS": "64000",
		"DISABLE_TELEMETRY": "1"
	},
	"alwaysThinkingEnabled": true,
	"includeCoAuthoredBy": false,
	"cleanupPeriodDays": 99999,
	"permissions": {
		"allow": [
			"Bash(cat:*)",
			"Bash(find:*)",
			"Bash(grep:*)",
			"Bash(rg:*)",
			"Bash(fd:*)",
			"Bash(head:*)",
			"Bash(tail:*)",
			"Bash(sort:*)",
			"Bash(uniq:*)",
			"Bash(awk:*)",
			"Bash(echo:*)",
			"Bash(pwd:*)",
			"Bash(mkdir:*)",
			"Bash(ls:*)",
			"Bash(cd:*)",
			"Bash(bat:*)",
			"Bash(jq:*)",
			"Bash(git:*)",
			"Bash(gh pr view:*)",
			"Bash(gh issue view:*)",
			"Bash(gh repo view:*)",
			"Bash(gh run view:*)",
			"Bash(gh run list:*)",
			"Bash(make:*)",
			"Bash(npm:*)",
			"Bash(npx:*)",
			"Bash(yarn:*)",
			"Bash(pnpm:*)",
			"Bash(go:*)",
			"Bash(cargo:*)",
			"Bash(kubectl get:*)",
			"Bash(kubectl describe:*)",
			"Bash(kubectl logs:*)",
			"WebSearch"
		],
		"deny": [
			"Read(**/.env)",
			"Read(**/.env.*)",
			"Read(**/.envrc)",
			"Read(**/.git)",
			"Read(**/node_modules)",
			"Read(**/.zshrc)",
			"Read(**/.zsh_history)",
			"Read(**/.bashrc)",
			"Read(**/.profile)",
			"Read(**/.zshenv)",
			"Read(/etc/zprofile)",
			"Read(/etc/zshenv)",
			"Read(/etc/zshrc)",
			"Write(**/.env)",
			"Write(**/.env.*)",
			"Write(**/.envrc)",
			"Write(**/.zshrc)",
			"Write(**/.bashrc)",
			"Write(**/.profile)",
			"Write(**/.zshenv)",
			"Write(**/.zsh_history)",
			"Write(/etc/zprofile)",
			"Write(/etc/zshenv)",
			"Write(/etc/zshrc)"
		],
		"ask": [
			"Bash(mv:*)",
			"Bash(cp:*)",
			"Bash(rm:*)",
			"Bash(curl:*)",
			"Bash(wget:*)",
			"Bash(ssh:*)",
			"Bash(sudo:*)",
			"Bash(su:*)",
			"Bash(xargs:*)",
			"Bash(node:*)",
			"Bash(git push:*)",
			"Bash(git rebase:*)",
			"Bash(git reset:*)",
			"Bash(git checkout:*)",
			"Bash(git clean:*)",
			"Bash(git branch -D:*)",
			"Bash(git filter-branch:*)",
			"Bash(git gc:*)",
			"Bash(git prune:*)",
			"Bash(git reflog:*)",
			"Bash(git restore:*)",
			"Bash(gh repo delete *)",
			"Bash(gh secret delete *)",
			"Bash(gh secret set *)",
			"Bash(kubectl apply:*)",
			"Bash(kubectl delete:*)",
			"Bash(docker:*)"
		]
	},
	"statusLine": {
		"type": "command",
		"command": "~/.claude/scripts/statusline.sh"
	},
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "~/.claude/hooks/log-event.sh SessionStart"
					}
				]
			}
		],
		"SessionEnd": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "~/.claude/hooks/log-event.sh SessionEnd"
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "~/.claude/hooks/log-event.sh UserPromptSubmit"
					}
				]
			}
		],
		"PreToolUse": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "~/.claude/hooks/log-event.sh PreToolUse"
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "~/.claude/hooks/validate-bash.sh"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "~/.claude/hooks/log-event.sh PostToolUse"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "~/.claude/hooks/log-event.sh Stop"
					}
				]
			}
		],
		"PreCompact": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "~/.claude/hooks/log-event.sh PreCompact"
					}
				]
			}
		],
		"PostCompact": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "~/.claude/hooks/log-event.sh PostCompact"
					}
				]
			}
		],
		"Notification": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "~/.claude/hooks/log-event.sh Notification"
					}
				]
			}
		]
	}
}
